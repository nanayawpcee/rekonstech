{
  "name": "rekonstech-landing",
  "version": "1.0.0",
  "description": "rekonstech Consulting and Trading Services — high-converting homepage landing page (NestJS + Handlebars + Tailwind CSS)",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build:css": "tailwindcss -i ./src/styles/tailwind.css -o ./public/css/styles.css --minify",
    "watch:css": "tailwindcss -i ./src/styles/tailwind.css -o ./public/css/styles.css --watch",
    "prebuild": "npm run build:css",
    "build": "nest build",
    "start": "npm run build:css && nest start",
    "start:dev": "concurrently -n css,nest -c magenta,cyan \"npm:watch:css\" \"nest start --watch\"",
    "start:prod": "node dist/main",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/throttler": "^6.4.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "hbs": "^4.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "simple-icons": "^16.28.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
