<span id="top" aria-hidden="true"></span>

{{> top-bar}}
{{> header}}

<main id="main" class="bg-[#080D13]">

  {{!-- ------------------------------------------------------------- hero --}}
  <section class="relative px-4 pb-16 pt-[104px] sm:px-6 lg:pb-24 lg:pt-[120px]">
    <div class="con-stage relative isolate mx-auto max-w-[1400px] overflow-clip rounded-[2.5rem] px-6 py-14 sm:px-10 lg:px-14 lg:py-16">
      {{!--
        Same fixed-height mobile banner / full-bleed desktop split used on the
        Consultancy and Networking heroes — an `inset-0 h-full` photo forced
        to cover the tall single-column mobile layout gets crushed to an
        unrecognisable sliver, so below `lg:` this is a normal-height banner
        instead, with the content pushed below it by matching top padding.
      --}}
      <img
        src="{{page.hero.image.src}}"
        alt="{{page.hero.image.alt}}"
        class="absolute inset-x-0 top-0 -z-10 h-[220px] w-full object-cover object-[64%_25%]
               sm:h-[280px] lg:inset-0 lg:h-full lg:object-[64%_center]"
        fetchpriority="high"
        decoding="async"
      />
      {{!-- Mobile-only: fades the banner into the stage's own background below it --}}
      <div
        class="absolute inset-x-0 top-0 -z-10 h-[220px] sm:h-[280px] lg:hidden"
        style="background:linear-gradient(180deg,rgba(7,21,34,0.05) 0%,rgba(7,21,34,0.35) 78%,#0a2138 100%)"
      ></div>
      {{!-- Desktop-only: the original text-legibility gradients over the full-bleed photo --}}
      <div
        class="absolute inset-0 -z-10 hidden lg:block"
        style="background:linear-gradient(90deg,#071522 0%,rgba(7,21,34,0.94) 34%,rgba(7,21,34,0.64) 58%,rgba(7,21,34,0.32) 100%)"
      ></div>
      <div
        class="absolute inset-0 -z-10 hidden lg:block"
        style="background:linear-gradient(180deg,rgba(7,21,34,0.55) 0%,transparent 26%,transparent 68%,rgba(7,21,34,0.62) 100%)"
      ></div>

      <div class="grid items-center gap-12 pt-[196px] sm:pt-[248px] lg:grid-cols-[1.05fr_1fr] lg:gap-10 lg:pt-0">
        <div class="relative">
          <p class="eyebrow-on-dark">{{page.hero.eyebrow}}</p>

          <h1 class="h1 text-white">
            {{page.hero.titleLead}}
            <span class="block text-accent-400">{{page.hero.titleAccent}}</span>
          </h1>

          <p class="mt-6 max-w-xl text-[15px] leading-7 text-ink-100">{{page.hero.copy}}</p>

          <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
            <a href="{{page.hero.primaryCta.href}}" class="btn-primary">
              {{page.hero.primaryCta.label}}
              {{{icon "arrow-right" "h-4 w-4"}}}
            </a>
            <a href="{{page.hero.secondaryCta.href}}" class="btn-outline">
              {{page.hero.secondaryCta.label}}
            </a>
          </div>

          <ul class="mt-10 flex flex-wrap gap-x-7 gap-y-3">
            {{#each page.hero.promises}}
              <li class="flex items-center gap-2.5 text-sm font-semibold text-white">
                <span class="grid h-9 w-9 place-items-center rounded-full border border-white/15 bg-white/[0.06] text-accent-400">
                  {{{icon this.icon "h-4 w-4"}}}
                </span>
                {{this.label}}
              </li>
            {{/each}}
          </ul>
        </div>

        {{!-- Quick facts --}}
        <div class="relative">
          <div class="rounded-[2rem] border border-white/10 bg-[#071522]/72 p-5 shadow-lift backdrop-blur-md sm:p-7">
            <p class="mb-5 font-mono text-[10px] uppercase tracking-[0.16em] text-ink-400">
              Who you'll actually work with
            </p>

            <dl class="space-y-5">
              {{#each page.hero.highlights}}
                <div class="flex items-baseline gap-3 border-b border-white/10 pb-4 last:border-0 last:pb-0">
                  <dd class="font-display text-3xl font-extrabold leading-none text-accent-500">{{this.value}}</dd>
                  <dt class="text-[13px] leading-5 text-ink-300">{{this.label}}</dt>
                </div>
              {{/each}}
            </dl>
          </div>
        </div>
      </div>
    </div>
  </section>

  {{!-- ----------------------------------------------------------- members --}}
  <section id="members" class="relative bg-white py-20 lg:py-24">
    <div class="container">
      <p class="eyebrow">{{page.members.eyebrow}}</p>
      <h2 class="reveal font-display text-[clamp(2.5rem,7vw,4.5rem)] font-extrabold uppercase leading-none tracking-tight text-ink-900">
        {{page.members.title}}
        <span class="block text-brand-600">{{page.members.titleAccent}}</span>
      </h2>
      <p class="lead reveal mt-5 max-w-2xl">{{page.members.copy}}</p>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {{#each page.members.items}}
          <article class="reveal group flex flex-col overflow-hidden rounded-3xl border border-ink-100 bg-white shadow-soft transition duration-300 hover:-translate-y-1.5 hover:border-brand-200 hover:shadow-lift">
            <div class="relative h-56 overflow-hidden">
              <img
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                src="{{this.image.src}}"
                alt="{{this.image.alt}}"
                loading="lazy"
                decoding="async"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-ink-950/80 via-ink-950/10 to-transparent"></div>
              <span class="absolute left-4 top-4 grid h-11 w-11 place-items-center rounded-xl bg-white/15 text-white backdrop-blur">
                {{{icon this.icon "h-5 w-5"}}}
              </span>
            </div>

            <div class="flex flex-1 flex-col p-6">
              <h3 class="text-lg leading-tight text-ink-900">{{this.name}}</h3>
              <p class="mt-1 text-[12.5px] font-bold uppercase tracking-wider text-brand-600">{{this.role}}</p>
              <p class="mt-3 text-sm leading-6 text-ink-400">{{this.bio}}</p>
            </div>
          </article>
        {{/each}}
      </div>
    </div>
  </section>

  {{!-- -------------------------------------------------------- team at work --}}
  <section class="relative bg-ink-50 py-20 lg:py-24">
    <div class="container">
      <p class="eyebrow">{{page.teamAtWork.eyebrow}}</p>
      <h2 class="reveal font-display text-[clamp(2.5rem,7vw,4.5rem)] font-extrabold uppercase leading-none tracking-tight text-ink-900">
        {{page.teamAtWork.title}}
        <span class="block text-brand-600">{{page.teamAtWork.titleAccent}}</span>
      </h2>
      <p class="lead reveal mt-5 max-w-2xl">{{page.teamAtWork.copy}}</p>

      <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {{#each page.teamAtWork.photos}}
          <div class="reveal group relative aspect-[4/3] overflow-hidden rounded-2xl shadow-soft">
            <img
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              src="{{this.image.src}}"
              alt="{{this.image.alt}}"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-ink-950/75 via-ink-950/5 to-transparent"></div>
            <p class="absolute inset-x-4 bottom-4 text-sm font-bold text-white">{{this.caption}}</p>
          </div>
        {{/each}}
      </div>
    </div>
  </section>

  {{!-- ------------------------------------------------------ how we work --}}
  <section class="relative overflow-hidden bg-ink-950 py-20 lg:py-24">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(900px_520px_at_50%_0%,rgba(26,117,188,0.22),transparent_65%)]"></div>

    <div class="container relative">
      <div class="reveal mx-auto max-w-2xl text-center">
        <p class="eyebrow-on-dark justify-center">{{page.principles.eyebrow}}</p>
        <h2 class="h2 text-white">
          {{page.principles.title}}
          <span class="block text-accent-500">{{page.principles.titleAccent}}</span>
        </h2>
        <p class="lead mt-5 text-ink-300">{{page.principles.copy}}</p>
      </div>

      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {{#each page.principles.items}}
          <article class="reveal rounded-2xl border border-white/10 bg-white/[0.04] p-6 backdrop-blur transition-colors hover:border-accent-500/40">
            <span class="grid h-12 w-12 place-items-center rounded-xl bg-white/5 text-accent-400">
              {{{icon this.icon "h-5 w-5"}}}
            </span>
            <h3 class="mt-5 text-base text-white">{{this.title}}</h3>
            <p class="mt-2 text-[13px] leading-6 text-ink-300">{{this.body}}</p>
          </article>
        {{/each}}
      </div>
    </div>
  </section>

  {{!-- ------------------------------------------------------- conversion --}}
  <section class="relative bg-white pb-20 pt-24 lg:pb-24">
    <div class="container">
      <div class="reveal mx-auto max-w-2xl text-center">
        <h2 class="h2">
          {{page.ctaBand.title}}
          <span class="block text-brand-600">{{page.ctaBand.titleAccent}}</span>
        </h2>
        <p class="lead mt-5">{{page.ctaBand.copy}}</p>
      </div>
    </div>

    <div class="mt-12">{{> request-bar}}</div>
  </section>
</main>

{{> side-rail}}
{{> footer}}
