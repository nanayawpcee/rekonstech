<span id="top" aria-hidden="true"></span>

{{> top-bar}}
{{> header}}

<main id="main" class="bg-[#080D13]">

  {{!--
    hero — the video is a fixed, full-viewport backdrop (not a contained band
    scrolling with the page): it stays pinned while this section's own text
    scrolls over it. `data-fixed-video-scope` drives the exit fade in site.js
    once this section's bottom passes the viewport top, since `position:fixed`
    ignores ancestor overflow/clipping entirely — nothing here would otherwise
    stop the video from painting straight through the white section below.
  --}}
  <section class="relative isolate overflow-hidden pb-16 pt-[104px] lg:pb-24 lg:pt-[120px]" data-fixed-video-scope>
    <video
      class="fixed inset-0 -z-10 h-full w-full object-cover object-center"
      data-autoplay-video
      src="{{page.hero.video.src}}"
      poster="{{page.hero.video.poster}}"
      aria-hidden="true"
      autoplay
      muted
      loop
      playsinline
    ></video>
    <div
      class="absolute inset-0 -z-10"
      style="background:linear-gradient(90deg,#06131F 0%,rgba(6,19,31,0.94) 34%,rgba(6,19,31,0.62) 58%,rgba(6,19,31,0.28) 100%)"
    ></div>
    <div
      class="absolute inset-0 -z-10"
      style="background:linear-gradient(180deg,rgba(6,19,31,0.55) 0%,transparent 26%,transparent 68%,rgba(6,19,31,0.62) 100%)"
    ></div>

    <div class="container relative">
      <div class="max-w-2xl">
        <p class="eyebrow-on-dark">
          {{page.hero.eyebrow}}
        </p>

        <h1 class="h1 text-white">
          {{page.hero.titleLead}}
          <span class="block text-brand-300">{{page.hero.titleAccent}}</span>
          {{page.hero.titleTail}}
        </h1>

        <p class="mt-6 max-w-xl text-[15px] leading-7 text-ink-100">{{page.hero.copy}}</p>

        <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
          <a href="{{page.hero.primaryCta.href}}" class="btn-primary">
            {{page.hero.primaryCta.label}}
            {{{icon "arrow-right" "h-4 w-4"}}}
          </a>
          <a href="{{page.hero.secondaryCta.href}}" class="btn-outline">
            {{page.hero.secondaryCta.label}}
          </a>
        </div>

        <ul class="mt-10 flex flex-wrap gap-x-7 gap-y-3">
          {{#each page.hero.promises}}
          <li class="flex items-center gap-2.5 text-sm font-semibold text-white">
            <span
              class="grid h-9 w-9 place-items-center rounded-full border border-white/15 bg-white/[0.06] text-accent-400">
              {{{icon this.icon "h-4 w-4"}}}
            </span>
            {{this.label}}
          </li>
          {{/each}}
        </ul>

        {{!-- Proof-of-work strip --}}
        <div class="mt-10 flex items-center gap-4">
          <span class="font-mono text-[10px] uppercase tracking-[0.16em] text-ink-400">
            {{page.hero.galleryLabel}}
          </span>
          <div class="flex gap-2.5">
            {{#each page.hero.gallery}}
            <img src="{{this.src}}" alt="{{this.alt}}"
              class="relative h-14 w-16 rounded-xl border border-white/15 object-cover shadow-soft
                     transition-transform duration-300 hover:z-10 hover:scale-[2] hover:shadow-lift
                     sm:h-16 sm:w-20"
              loading="lazy" decoding="async" />
            {{/each}}
          </div>
        </div>
      </div>
    </div>
  </section>

  {{!-- --------------------------------------------------------- services --}}
  <section id="services" class="relative bg-white py-20 lg:py-24">
    <div class="container">
      <p class="eyebrow">{{page.services.eyebrow}}</p>
      <h2
        class="reveal font-display text-[clamp(2.5rem,7vw,4.5rem)] font-extrabold uppercase leading-none tracking-tight text-ink-900">
        {{page.services.title}}
      </h2>
      <p class="lead reveal mt-5 max-w-2xl">{{page.services.copy}}</p>

      <div class="mt-12 grid gap-6 lg:grid-cols-3">
        {{#each page.services.items}}
        <article
          class="reveal group flex flex-col overflow-hidden rounded-3xl border border-ink-100 bg-white shadow-soft transition duration-300 hover:-translate-y-1.5 hover:border-brand-200 hover:shadow-lift">
          <div class="relative h-48 overflow-hidden">
            <img class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              src="{{this.image.src}}" alt="{{this.image.alt}}" loading="lazy" decoding="async" />
            <div class="absolute inset-0 bg-gradient-to-t from-ink-950/85 via-ink-950/20 to-transparent"></div>
            <span
              class="absolute left-4 top-4 grid h-11 w-11 place-items-center rounded-xl bg-white/15 text-white backdrop-blur">
              {{{icon this.icon "h-5 w-5"}}}
            </span>
            <h3 class="absolute inset-x-4 bottom-3 text-lg leading-tight text-white">{{this.title}}</h3>
          </div>

          <div class="flex flex-1 flex-col p-7">
            <p class="text-sm leading-6 text-ink-400">{{this.summary}}</p>

            <ul class="mt-5 flex-1 space-y-2.5 border-t border-ink-100 pt-5">
              {{#each this.features}}
              <li class="flex items-start gap-2.5 text-[13px] leading-5 text-ink-700">
                <span
                  class="mt-0.5 grid h-4 w-4 shrink-0 place-items-center rounded-full bg-accent-100 text-accent-700">
                  {{{icon "check" "h-2.5 w-2.5"}}}
                </span>
                {{this}}
              </li>
              {{/each}}
            </ul>

            <p class="mt-6 flex items-center gap-2 text-[11px] font-bold uppercase tracking-wider text-brand-600">
              {{{icon "clock" "h-3.5 w-3.5"}}}
              {{this.outcome}}
            </p>
          </div>
        </article>
        {{/each}}
      </div>
    </div>
  </section>

  {{!-- ----------------------------------------------------- environments --}}
  <section class="relative overflow-hidden bg-ink-950 py-20 lg:py-24">
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(900px_520px_at_50%_0%,rgba(26,117,188,0.22),transparent_65%)]">
    </div>

    <div class="container relative">
      <div class="reveal mx-auto max-w-2xl text-center">
        <p class="eyebrow-on-dark justify-center">
          {{page.environments.eyebrow}}
        </p>
        <h2 class="h2 text-white">
          {{page.environments.title}}
          <span class="block text-accent-500">{{page.environments.titleAccent}}</span>
        </h2>
        <p class="lead mt-5 text-ink-300">{{page.environments.copy}}</p>
      </div>

      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {{#each page.environments.items}}
        <article
          class="reveal rounded-2xl border border-white/10 bg-white/[0.04] p-6 backdrop-blur transition-colors hover:border-accent-500/40">
          <span class="grid h-12 w-12 place-items-center rounded-xl bg-white/5 text-accent-400">
            {{{icon this.icon "h-5 w-5"}}}
          </span>
          <h3 class="mt-5 text-base text-white">{{this.title}}</h3>
          <p class="mt-2 text-[13px] leading-6 text-ink-300">{{this.body}}</p>
        </article>
        {{/each}}
      </div>

      {{!-- Service levels --}}
      <dl class="reveal mt-12 grid gap-6 rounded-[2rem] border border-white/10 bg-white/[0.03] p-8 sm:grid-cols-3">
        {{#each page.metrics.items}}
        <div class="text-center">
          <dd class="font-display text-4xl font-extrabold leading-none text-accent-500">{{this.value}}</dd>
          <dt class="mt-2 text-xs font-semibold uppercase tracking-wider text-ink-300">{{this.label}}</dt>
        </div>
        {{/each}}
      </dl>
    </div>
  </section>

  {{!-- ---------------------------------------------------------- process --}}
  <section class="relative bg-ink-50 py-20 lg:py-24">
    <div class="container">
      <div class="reveal mx-auto max-w-2xl text-center">
        <p class="eyebrow justify-center">
          {{page.process.eyebrow}}
        </p>
        <h2 class="h2">
          {{page.process.title}}
          <span class="block text-brand-600">{{page.process.titleAccent}}</span>
        </h2>
        <p class="lead mt-5">{{page.process.copy}}</p>
      </div>

      <ol class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-5">
        {{#each page.process.steps}}
        <li class="reveal rounded-2xl border border-ink-100 bg-white p-6 shadow-soft">
          <span
            class="grid h-11 w-11 place-items-center rounded-full bg-ink-900 font-display text-sm font-extrabold text-accent-400">
            {{inc @index}}
          </span>
          <h3 class="mt-5 text-base font-bold text-ink-900">{{this.title}}</h3>
          <p class="mt-2 text-[13px] leading-6 text-ink-400">{{this.body}}</p>
        </li>
        {{/each}}
      </ol>
    </div>
  </section>

  {{!-- ------------------------------------------------------- conversion --}}
  <section class="relative bg-white pb-20 pt-24 lg:pb-24">
    <div class="container">
      <div class="reveal mx-auto max-w-2xl text-center">
        <h2 class="h2">
          {{page.ctaBand.title}}
          <span class="block text-brand-600">{{page.ctaBand.titleAccent}}</span>
        </h2>
        <p class="lead mt-5">{{page.ctaBand.copy}}</p>
      </div>
    </div>

    <div class="mt-12">{{> request-bar}}</div>
  </section>
</main>

{{> side-rail}}
{{> footer}}