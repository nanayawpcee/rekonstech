{{!--
  Quote basket. Progressive enhancement: with no JavaScript neither the toggle
  nor the drawer is shown, and the catalogue simply reads as a price list while
  the request form still works on its own.
--}}
<div id="quote-basket" class="qb" hidden>
  <button type="button" class="qb-toggle" data-qb-open aria-controls="qb-drawer" aria-expanded="false">
    {{{icon "package" "h-5 w-5"}}}
    <span class="hidden sm:inline">Your quote</span>
    <span class="qb-count" data-qb-count>0</span>
  </button>

  <div class="qb-scrim" data-qb-close hidden></div>

  <aside id="qb-drawer" class="qb-drawer" aria-label="Your quote" hidden>
    <header class="flex items-center justify-between border-b border-ink-100 px-6 py-5">
      <div>
        <h2 class="text-base">Your quote</h2>
        <p class="mt-0.5 text-[11.5px] text-ink-400" data-qb-subtitle>No items yet</p>
      </div>
      <button
        type="button"
        data-qb-close
        class="grid h-9 w-9 place-items-center rounded-full bg-ink-50 text-ink-500 transition-colors hover:bg-ink-100 hover:text-ink-800"
        aria-label="Close quote"
      >
        {{{icon "x" "h-4 w-4"}}}
      </button>
    </header>

    <ul class="qb-lines" data-qb-lines></ul>

    <p class="qb-empty px-6 py-10 text-center text-sm text-ink-400" data-qb-empty>
      Add equipment from the catalogue and it will collect here.
    </p>

    <footer class="mt-auto border-t border-ink-100 px-6 py-5">
      {{#if catalogue.meta.showPricing}}
        <div class="flex items-baseline justify-between">
          <span class="text-xs font-semibold uppercase tracking-wider text-ink-400">Indicative total</span>
          <span class="font-display text-xl font-extrabold text-ink-900" data-qb-total>{{catalogue.meta.currency}} 0</span>
        </div>
        <p class="mt-1.5 text-[11px] leading-5 text-ink-400">{{catalogue.meta.priceNote}}</p>
      {{else}}
        <p class="text-[11.5px] leading-5 text-ink-400">{{catalogue.meta.noPriceNote}}</p>
      {{/if}}

      <a href="#request" class="pill-cta mt-5 w-full whitespace-nowrap !pl-5 !text-[13px]" data-qb-send>
        Send as enquiry
        <span class="pill-cta-badge">{{{icon "arrow-right" "h-4 w-4"}}}</span>
      </a>
      <button
        type="button"
        data-qb-clear
        class="mt-3 w-full text-center text-xs font-semibold text-ink-400 underline underline-offset-4 transition-colors hover:text-red-600"
      >
        Clear the quote
      </button>
    </footer>
  </aside>
</div>
