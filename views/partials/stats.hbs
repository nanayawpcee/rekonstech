<section class="border-y border-ink-100 bg-ink-50/70 py-12 md:py-14">
  <div class="container">
    <dl class="grid gap-y-10 sm:grid-cols-2 lg:grid-cols-4 lg:divide-x lg:divide-ink-200">
      {{#each site.stats}}
        <div class="reveal flex items-center gap-4 lg:justify-center lg:px-6">
          <span class="grid h-14 w-14 shrink-0 place-items-center rounded-2xl bg-white text-brand-600 shadow-soft">
            {{{icon this.icon "h-6 w-6"}}}
          </span>
          <div>
            <dd
              class="font-display text-3xl font-extrabold leading-none text-ink-900 sm:text-[34px]"
              {{#if this.countTo}}data-count-to="{{this.countTo}}" data-suffix="{{this.suffix}}"{{/if}}
            >
              {{this.value}}
            </dd>
            <dt class="mt-1.5 text-sm font-semibold text-ink-400">{{this.label}}</dt>
          </div>
        </div>
      {{/each}}
    </dl>
  </div>
</section>
