<section class="relative isolate overflow-hidden bg-ink-950 py-20 md:py-24">
  <img
    src="{{site.ctaBand.image}}"
    alt=""
    aria-hidden="true"
    class="absolute inset-0 -z-10 h-full w-full object-cover opacity-40"
    loading="lazy"
    decoding="async"
  />
  <div class="absolute inset-0 -z-10 bg-gradient-to-r from-ink-950 via-ink-950/90 to-ink-950/60"></div>

  <div class="container">
    <div class="grid items-center gap-10 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <p class="eyebrow-on-dark">
          <span class="h-px w-8 bg-accent-500"></span>
          {{site.ctaBand.eyebrow}}
        </p>
        <h2 class="h2 text-white">
          {{site.ctaBand.title}}
          <span class="text-accent-400">{{site.ctaBand.titleAccent}}</span>
        </h2>
        <p class="lead mt-5 max-w-xl text-ink-200">{{site.ctaBand.copy}}</p>

        <ul class="mt-7 flex flex-wrap gap-x-8 gap-y-3">
          {{#each site.ctaBand.points}}
            <li class="flex items-center gap-2.5 text-sm font-semibold text-white">
              <span class="grid h-6 w-6 place-items-center rounded-full bg-accent-500 text-ink-900">
                {{{icon "check" "h-3.5 w-3.5"}}}
              </span>
              {{this}}
            </li>
          {{/each}}
        </ul>
      </div>

      <div class="lg:col-span-5">
        <div class="rounded-[2rem] border border-white/10 bg-white/10 p-7 backdrop-blur-md">
          <p class="text-sm font-semibold text-ink-200">Speak to a consultant today</p>
          <a
            href="{{site.company.phoneHref}}"
            class="mt-2 flex items-center gap-3 font-display text-2xl font-extrabold text-white transition-colors hover:text-accent-400 sm:text-3xl"
          >
            {{{icon "phone" "h-6 w-6 text-accent-500"}}}
            {{site.company.phone}}
          </a>
          <div class="mt-6 grid gap-3">
            <a href="#request" class="btn-primary w-full">
              Get a Free Quote
              {{{icon "arrow-right" "h-4 w-4"}}}
            </a>
            <a href="mailto:{{site.company.email}}" class="btn-outline w-full">
              {{{icon "mail" "h-4 w-4"}}}
              {{site.company.email}}
            </a>
          </div>
          <p class="mt-5 flex items-center gap-2 text-xs text-ink-300">
            {{{icon "clock" "h-4 w-4 text-accent-500"}}}
            {{site.company.businessHours}} · {{site.company.supportHours}}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
