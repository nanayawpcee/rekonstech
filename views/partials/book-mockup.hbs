{{!--
  Interface mockups printed into the book pages — pure markup, no screenshots,
  so they stay crisp at any scale and cost nothing to load.
  Usage: {{> book-mockup kind="dashboard"}}
--}}

{{#ifEquals kind "dashboard"}}
  <figure class="bk-mock">
    <figcaption class="bk-mock-chrome">
      <span class="bk-mock-dot"></span><span class="bk-mock-dot"></span><span class="bk-mock-dot"></span>
      <span class="ml-1.5 text-[7px] font-bold uppercase tracking-[0.14em] text-ink-300">Operations dashboard</span>
    </figcaption>

    <div class="flex h-[104px]">
      {{!-- sidebar --}}
      <div class="w-[46px] shrink-0 space-y-1.5 border-r border-ink-100 bg-ink-50/80 p-2">
        <span class="block h-1.5 w-7 rounded-full bg-brand-600"></span>
        <span class="block h-1.5 w-5 rounded-full bg-ink-200"></span>
        <span class="block h-1.5 w-6 rounded-full bg-ink-200"></span>
        <span class="block h-1.5 w-4 rounded-full bg-ink-200"></span>
      </div>

      <div class="flex-1 p-2">
        {{!-- stat tiles --}}
        <div class="grid grid-cols-3 gap-1.5">
          <div class="rounded border border-ink-100 p-1.5">
            <span class="block h-1 w-5 rounded-full bg-ink-200"></span>
            <span class="mt-1 block h-2 w-7 rounded-sm bg-ink-800"></span>
          </div>
          <div class="rounded border border-ink-100 p-1.5">
            <span class="block h-1 w-4 rounded-full bg-ink-200"></span>
            <span class="mt-1 block h-2 w-6 rounded-sm bg-brand-600"></span>
          </div>
          <div class="rounded border border-ink-100 p-1.5">
            <span class="block h-1 w-5 rounded-full bg-ink-200"></span>
            <span class="mt-1 block h-2 w-5 rounded-sm bg-accent-500"></span>
          </div>
        </div>

        {{!-- chart --}}
        <div class="mt-2 flex h-[52px] items-end gap-[3px] border-b border-ink-100 pb-1">
          <span class="h-[38%] flex-1 rounded-t-sm bg-brand-200"></span>
          <span class="h-[62%] flex-1 rounded-t-sm bg-brand-300"></span>
          <span class="h-[46%] flex-1 rounded-t-sm bg-brand-200"></span>
          <span class="h-[78%] flex-1 rounded-t-sm bg-brand-600"></span>
          <span class="h-[54%] flex-1 rounded-t-sm bg-brand-300"></span>
          <span class="h-[88%] flex-1 rounded-t-sm bg-accent-500"></span>
          <span class="h-[64%] flex-1 rounded-t-sm bg-brand-300"></span>
          <span class="h-[42%] flex-1 rounded-t-sm bg-brand-200"></span>
        </div>
      </div>
    </div>
  </figure>
{{/ifEquals}}

{{#ifEquals kind "website"}}
  <figure class="bk-mock">
    <figcaption class="bk-mock-chrome">
      <span class="bk-mock-dot"></span><span class="bk-mock-dot"></span><span class="bk-mock-dot"></span>
      <span class="ml-1.5 flex-1 rounded-full bg-ink-100 px-1.5 py-[2px] text-[7px] text-ink-400">yourcompany.com</span>
    </figcaption>

    <div class="h-[104px] p-2">
      {{!-- nav --}}
      <div class="flex items-center justify-between">
        <span class="h-2 w-8 rounded-sm bg-brand-600"></span>
        <div class="flex gap-1.5">
          <span class="h-1 w-4 rounded-full bg-ink-200"></span>
          <span class="h-1 w-5 rounded-full bg-ink-200"></span>
          <span class="h-1 w-3 rounded-full bg-ink-200"></span>
          <span class="h-1.5 w-6 rounded-full bg-accent-500"></span>
        </div>
      </div>

      {{!-- hero --}}
      <div class="mt-2 flex gap-2">
        <div class="flex-1">
          <span class="block h-2.5 w-full rounded-sm bg-ink-800"></span>
          <span class="mt-1 block h-2.5 w-3/5 rounded-sm bg-brand-600"></span>
          <span class="mt-1.5 block h-1 w-11/12 rounded-full bg-ink-200"></span>
          <span class="mt-1 block h-1 w-4/5 rounded-full bg-ink-200"></span>
          <span class="mt-2 block h-3 w-12 rounded-full bg-accent-500"></span>
        </div>
        <div class="w-[74px] shrink-0 rounded bg-gradient-to-br from-brand-200 to-brand-600"></div>
      </div>

      {{!-- cards --}}
      <div class="mt-2 grid grid-cols-3 gap-1.5">
        <span class="h-4 rounded border border-ink-100 bg-ink-50"></span>
        <span class="h-4 rounded border border-ink-100 bg-ink-50"></span>
        <span class="h-4 rounded border border-ink-100 bg-ink-50"></span>
      </div>
    </div>
  </figure>
{{/ifEquals}}

{{#ifEquals kind "monitoring"}}
  <figure class="bk-mock">
    <figcaption class="bk-mock-chrome">
      <span class="bk-mock-dot"></span><span class="bk-mock-dot"></span><span class="bk-mock-dot"></span>
      <span class="ml-1.5 text-[7px] font-bold uppercase tracking-[0.14em] text-ink-300">Uptime monitor</span>
    </figcaption>

    <div class="h-[104px] space-y-2 p-2">
      <div class="flex items-center gap-1.5 rounded border border-accent-200 bg-accent-50 px-2 py-1">
        <span class="h-1.5 w-1.5 rounded-full bg-accent-500"></span>
        <span class="text-[7.5px] font-bold uppercase tracking-[0.12em] text-accent-700">All systems operational</span>
        <span class="ml-auto text-[7.5px] font-bold text-accent-700">99.98%</span>
      </div>

      {{#each (array "Web app" "API" "Database")}}
        <div class="flex items-center gap-2">
          <span class="w-[42px] shrink-0 text-[7.5px] font-semibold text-ink-500">{{this}}</span>
          <span class="flex flex-1 gap-[2px]">
            {{#each (range 18)}}
              <span class="h-3 flex-1 rounded-[1px] {{#ifEquals this 11}}bg-amber-400{{else}}bg-accent-400{{/ifEquals}}"></span>
            {{/each}}
          </span>
        </div>
      {{/each}}
    </div>
  </figure>
{{/ifEquals}}
