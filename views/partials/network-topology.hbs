{{!--
  Live network topology: cloud → firewall → core switch → access layer, with
  packets running the links. Drawn from primitives so it scales cleanly and
  costs nothing to load. Packet motion uses CSS offset-path, so it stops under
  prefers-reduced-motion like every other animation on the site.
--}}
<svg
  class="net-map"
  viewBox="0 0 620 520"
  role="img"
  aria-label="Network topology: internet and VPN through a firewall to a core switch, then to Wi-Fi, workstations and cameras"
>
  <defs>
    {{!--
      userSpaceOnUse, not the default objectBoundingBox: three of these links are
      perfectly vertical, and a zero-width bounding box makes an
      objectBoundingBox gradient degenerate — those links would not paint at all.
    --}}
    <linearGradient id="net-link" gradientUnits="userSpaceOnUse" x1="310" y1="90" x2="310" y2="470">
      <stop offset="0%" stop-color="#7DBBE4" stop-opacity="0.7" />
      <stop offset="100%" stop-color="#2A90E8" stop-opacity="0.35" />
    </linearGradient>
    <filter id="net-glow" x="-120%" y="-120%" width="340%" height="340%">
      <feGaussianBlur stdDeviation="4" result="b" />
      <feMerge>
        <feMergeNode in="b" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>
  </defs>

  {{!-- Links --}}
  <g class="net-links" stroke="url(#net-link)" stroke-width="2" fill="none" stroke-linecap="round">
    <path d="M310 108 L310 182" />
    <path d="M310 244 L310 302" />
    <path d="M288 352 L150 408" />
    <path d="M310 362 L310 414" />
    <path d="M332 352 L470 408" />
  </g>

  {{!-- Packets --}}
  <g class="net-packets">
    <circle r="4" class="net-packet" style="offset-path:path('M310 108 L310 182');animation-delay:0s" />
    <circle r="4" class="net-packet net-packet--up" style="offset-path:path('M310 244 L310 302');animation-delay:-1.1s" />
    <circle r="3.5" class="net-packet" style="offset-path:path('M288 352 L150 408');animation-delay:-0.4s" />
    <circle r="3.5" class="net-packet" style="offset-path:path('M310 362 L310 414');animation-delay:-1.7s" />
    <circle r="3.5" class="net-packet net-packet--up" style="offset-path:path('M332 352 L470 408');animation-delay:-2.3s" />
  </g>

  {{!-- Cloud / internet --}}
  <g class="net-node">
    <circle cx="310" cy="70" r="38" class="net-halo" />
    <g fill="#0E1A2C" stroke="#7DBBE4" stroke-width="2">
      <circle cx="292" cy="68" r="15" />
      <circle cx="318" cy="60" r="19" />
      <circle cx="332" cy="74" r="13" />
      <rect x="278" y="72" width="62" height="16" rx="8" />
    </g>
    <text x="310" y="126" class="net-label">INTERNET · VPN</text>
  </g>

  {{!-- Firewall / router --}}
  <g class="net-node">
    <circle cx="310" cy="213" r="46" class="net-pulse" />
    <circle cx="310" cy="213" r="46" class="net-pulse net-pulse--b" />
    <rect x="262" y="192" width="96" height="42" rx="12" fill="#12233A" stroke="#2A90E8" stroke-width="2" />
    <g fill="#66D110">
      <circle cx="280" cy="213" r="3.5" />
      <circle cx="296" cy="213" r="3.5" />
    </g>
    <path d="M318 206 h26 M318 213 h20 M318 220 h26" stroke="#7DBBE4" stroke-width="2" stroke-linecap="round" />
    <text x="310" y="262" class="net-label">FIREWALL · ROUTER</text>
  </g>

  {{!-- Core switch --}}
  <g class="net-node">
    <rect x="248" y="312" width="124" height="40" rx="10" fill="#12233A" stroke="#2A90E8" stroke-width="2" />
    <g fill="#7DBBE4">
      <rect x="262" y="326" width="12" height="12" rx="3" />
      <rect x="280" y="326" width="12" height="12" rx="3" />
      <rect x="298" y="326" width="12" height="12" rx="3" />
      <rect x="316" y="326" width="12" height="12" rx="3" />
      <rect x="334" y="326" width="12" height="12" rx="3" />
      <rect x="352" y="326" width="8" height="12" rx="3" fill="#66D110" />
    </g>
    <text x="310" y="378" class="net-label">CORE SWITCH</text>
  </g>

  {{!-- Wi-Fi access point --}}
  <g class="net-node">
    <circle cx="122" cy="424" r="26" fill="#12233A" stroke="#2A90E8" stroke-width="2" />
    <circle cx="122" cy="430" r="4" fill="#66D110" />
    <g class="net-waves" fill="none" stroke="#66D110" stroke-width="2.5" stroke-linecap="round">
      <path d="M112 422 a14 14 0 0 1 20 0" class="net-wave" style="animation-delay:0s" />
      <path d="M105 415 a24 24 0 0 1 34 0" class="net-wave" style="animation-delay:0.35s" />
      <path d="M98 408 a34 34 0 0 1 48 0" class="net-wave" style="animation-delay:0.7s" />
    </g>
    <text x="122" y="474" class="net-label">WI-FI ACCESS</text>
  </g>

  {{!-- Workstations --}}
  <g class="net-node">
    <rect x="278" y="424" width="64" height="40" rx="6" fill="#12233A" stroke="#2A90E8" stroke-width="2" />
    <rect x="288" y="434" width="44" height="20" rx="3" fill="#0B1B2E" />
    <rect x="268" y="468" width="84" height="6" rx="3" fill="#2A90E8" fill-opacity="0.55" />
    <text x="310" y="496" class="net-label">WORKSTATIONS</text>
  </g>

  {{!-- Cameras / IoT --}}
  <g class="net-node">
    <rect x="466" y="410" width="54" height="26" rx="8" fill="#12233A" stroke="#2A90E8" stroke-width="2" />
    <path d="M520 416 l16 -8 v26 l-16 -8 z" fill="#12233A" stroke="#2A90E8" stroke-width="2" stroke-linejoin="round" />
    <circle cx="480" cy="423" r="5" fill="#66D110" />
    <path d="M486 436 l-8 20" stroke="#2A90E8" stroke-width="2" stroke-linecap="round" />
    <text x="496" y="474" class="net-label">CAMERAS · IOT</text>
  </g>
</svg>
