<section class="relative isolate overflow-hidden bg-ink-950 pb-16 pt-[132px] lg:pb-24 lg:pt-[168px]">
  {{!--
    Background photograph + legibility gradients.
    object-position sits above centre: the frame is a group shot, and a centred
    crop of a square image in a wide band clips the hard hats.
  --}}
  <img
    src="{{site.hero.image.src}}"
    alt="{{site.hero.image.alt}}"
    class="absolute inset-0 -z-10 h-full w-full object-cover object-[center_32%]"
    fetchpriority="high"
    decoding="async"
  />
  <div class="absolute inset-0 -z-10 bg-gradient-to-r from-ink-950 via-ink-950/90 to-ink-950/20"></div>
  <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink-950 via-transparent to-ink-950/60"></div>
  <div class="absolute inset-0 -z-10 bg-grid-faint [background-size:56px_56px] opacity-40"></div>

  <div class="container">
    <div class="max-w-2xl">
      <p class="eyebrow-on-dark">
        {{site.hero.eyebrow}}
      </p>

      <h1 class="h1 text-white">
        {{site.hero.titleLead}}
        <span class="text-accent-400">{{site.hero.titleAccent}}</span>
        {{site.hero.titleTail}}
      </h1>

      <p class="lead mt-6 max-w-xl text-ink-200">{{site.hero.copy}}</p>

      <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a href="{{site.hero.primaryCta.href}}" class="btn-primary">
          {{site.hero.primaryCta.label}}
          {{{icon "arrow-right" "h-4 w-4"}}}
        </a>
        <a href="{{site.hero.secondaryCta.href}}" class="btn-outline">
          {{site.hero.secondaryCta.label}}
        </a>
      </div>
    </div>

    {{!-- Social proof + trust badges --}}
    <div class="mt-14 flex flex-col gap-4 lg:mt-20 lg:flex-row lg:items-stretch">
      <div class="flex items-center gap-4 rounded-3xl border border-white/10 bg-white/10 p-3 pr-6 backdrop-blur-md">
        <div class="flex -space-x-3">
          <span class="grid h-11 w-11 place-items-center rounded-full border-2 border-ink-950 bg-brand-500 text-xs font-bold text-white">AK</span>
          <span class="grid h-11 w-11 place-items-center rounded-full border-2 border-ink-950 bg-brand-700 text-xs font-bold text-white">MO</span>
          <span class="grid h-11 w-11 place-items-center rounded-full border-2 border-ink-950 bg-accent-500 text-xs font-bold text-ink-900">SD</span>
          <span class="grid h-11 w-11 place-items-center rounded-full border-2 border-ink-950 bg-ink-600 text-xs font-bold text-white">PB</span>
        </div>
        <div>
          <p class="font-display text-lg font-extrabold leading-none text-white">
            {{site.hero.socialProof.value}}
            <span class="text-sm font-bold text-ink-200">{{site.hero.socialProof.label}}</span>
          </p>
          <p class="mt-1.5 flex items-center gap-1 text-xs text-ink-200">
            <span class="flex text-accent-400">
              {{{icon "star" "h-3.5 w-3.5"}}}{{{icon "star" "h-3.5 w-3.5"}}}{{{icon "star" "h-3.5 w-3.5"}}}{{{icon "star" "h-3.5 w-3.5"}}}{{{icon "star" "h-3.5 w-3.5"}}}
            </span>
            {{site.hero.socialProof.rating}}
          </p>
        </div>
      </div>

      <div class="flex-1 rounded-3xl border border-white/10 bg-white/10 p-5 backdrop-blur-md">
        <p class="mb-4 text-sm font-bold text-white">Recognised for excellence in IT service delivery</p>
        <ul class="flex flex-wrap items-center gap-x-6 gap-y-3">
          {{#each site.hero.badges}}
            <li class="flex items-center gap-2 text-xs font-semibold text-ink-100">
              <span class="grid h-8 w-8 place-items-center rounded-full bg-white/10 text-accent-400">
                {{{icon this.icon "h-4 w-4"}}}
              </span>
              {{this.label}}
            </li>
          {{/each}}
        </ul>
      </div>
    </div>
  </div>
</section>
