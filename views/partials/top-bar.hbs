<div class="relative z-40 bg-ink-950 text-ink-200">
  <div class="container flex h-auto flex-wrap items-center justify-between gap-x-6 gap-y-2 py-2.5">
    <ul class="flex flex-wrap items-center gap-x-6 gap-y-1.5 text-[13px]">
      <li>
        <a
          href="{{site.company.phoneHref}}"
          class="flex items-center gap-2 transition-colors hover:text-accent-400"
        >
          {{{icon "phone" "h-3.5 w-3.5 text-accent-500"}}}
          <span class="font-semibold">{{site.company.phone}}</span>
        </a>
      </li>
      <li class="hidden sm:block">
        <a
          href="mailto:{{site.company.email}}"
          class="flex items-center gap-2 transition-colors hover:text-accent-400"
        >
          {{{icon "mail" "h-3.5 w-3.5 text-accent-500"}}}
          <span>{{site.company.email}}</span>
        </a>
      </li>
      <li class="hidden items-center gap-2 lg:flex">
        {{{icon "clock" "h-3.5 w-3.5 text-accent-500"}}}
        <span>{{site.company.supportHours}}</span>
      </li>
    </ul>

    <a
      href="{{site.company.emergencyPhoneHref}}"
      class="group inline-flex items-center gap-2 rounded-full bg-accent-500 px-4 py-1.5 text-[13px] font-bold text-ink-900 transition-colors hover:bg-accent-400"
    >
      <span class="relative flex h-2 w-2">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-ink-900/60"></span>
        <span class="relative inline-flex h-2 w-2 rounded-full bg-ink-900"></span>
      </span>
      Emergency IT Support
      <span class="hidden sm:inline">· {{site.company.emergencyPhone}}</span>
    </a>
  </div>
</div>
