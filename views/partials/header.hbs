{{!--
Sticky header. Sits transparent over the dark hero, then swaps to a solid
white bar once the page scrolls (site.js toggles `.is-stuck`).
--}}
{{!--
  data-solid marks pages whose hero is light: the header must start in its solid
  state instead of white-on-white. The class is also baked in so the no-JS
  rendering is correct, and site.js keeps it pinned on.
--}}
<header id="site-header" {{#if lightHeader}}data-solid="true"{{/if}}
  class="relative z-50 -mb-[88px] transition-all duration-300 [&.is-stuck]:bg-white/95 [&.is-stuck]:shadow-soft [&.is-stuck]:backdrop-blur {{#if lightHeader}}is-stuck{{/if}}">
  <div class="container flex h-[88px] items-center justify-between gap-4">
    <span class="[.is-stuck_&]:hidden">{{> logo tone="dark"}}</span>
    <span class="hidden [.is-stuck_&]:inline-flex">{{> logo}}</span>

    <nav class="hidden items-center gap-8 lg:flex" aria-label="Primary">
      {{#each site.nav}}
      <a href="{{this.href}}" class="relative text-sm font-semibold text-white/85 transition-colors hover:text-white
                 after:absolute after:-bottom-1.5 after:left-0 after:h-0.5 after:w-0 after:rounded-full
                 after:bg-accent-500 after:transition-all after:duration-300 hover:after:w-full
                 [.is-stuck_&]:text-ink-700 [.is-stuck_&]:hover:text-brand-600">
        {{this.label}}
      </a>
      {{/each}}
    </nav>

    <div class="flex items-center gap-3">
      <a href="{{site.company.phoneHref}}" class="hidden items-center gap-3 xl:flex"
        aria-label="Call {{site.company.phone}}">
        <span class="grid h-11 w-11 place-items-center rounded-full border border-white/25 bg-white/10 text-white
                 [.is-stuck_&]:border-brand-100 [.is-stuck_&]:bg-brand-50 [.is-stuck_&]:text-brand-600">
          {{{icon "phone" "h-4 w-4"}}}
        </span>
        <span class="flex flex-col leading-tight">
          <span class="text-[11px] font-semibold uppercase tracking-wider text-white/60 [.is-stuck_&]:text-ink-400">
            Call Us
          </span>
          <span class="text-sm font-bold text-white [.is-stuck_&]:text-ink-900">{{site.company.phone}}</span>
        </span>
      </a>

      <a href="#request" class="btn-primary hidden md:inline-flex">
        Get a Free Quote
        {{{icon "arrow-right" "h-4 w-4"}}}
      </a>

      <button type="button" id="menu-toggle" class="grid h-11 w-11 place-items-center rounded-full border border-white/25 bg-white/10 text-white
               transition-colors hover:bg-white/20 lg:hidden
               [.is-stuck_&]:border-ink-200 [.is-stuck_&]:bg-white [.is-stuck_&]:text-ink-900" aria-expanded="false"
        aria-controls="mobile-menu">
        <span class="sr-only">Toggle navigation</span>
        {{{icon "menu" "h-5 w-5" }}}
      </button>
    </div>
  </div>

  {{!-- Mobile navigation panel --}}
  {{!-- Absolute so opening the panel overlays the hero instead of shifting it --}}
  <div id="mobile-menu" class="absolute inset-x-0 top-[84px] hidden px-5 lg:hidden" data-open="false">
    <div class="rounded-3xl border border-ink-100 bg-white p-5 shadow-lift">
      <nav class="flex flex-col divide-y divide-ink-100" aria-label="Mobile">
        {{#each site.nav}}
        <a href="{{this.href}}"
          class="flex items-center justify-between py-3 text-sm font-bold text-ink-800 transition-colors hover:text-brand-600"
          data-mobile-link>
          {{this.label}}
          {{{icon "arrow-right" "h-4 w-4 text-ink-300"}}}
        </a>
        {{/each}}
      </nav>
      <a href="#request" class="btn-primary mt-5 w-full" data-mobile-link>
        Get a Free Quote
        {{{icon "arrow-right" "h-4 w-4"}}}
      </a>
      <a href="{{site.company.phoneHref}}"
        class="mt-3 flex items-center justify-center gap-2 text-sm font-bold text-ink-700">
        {{{icon "phone" "h-4 w-4 text-brand-600"}}}
        {{site.company.phone}}
      </a>
    </div>
  </div>
</header>