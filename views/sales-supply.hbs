<span id="top" aria-hidden="true"></span>

{{> top-bar}}
{{> header}}

<main id="main" class="bg-white">

  {{!--
    hero, assurances, services and the catalogue all share one fixed video
    backdrop: it stays pinned to the viewport while every section's own
    content scrolls over it, only fading out once `data-fixed-video-scope`
    (this wrapper) has scrolled past, not right after the hero. That's also
    why none of these sections carry an opaque background of their own below;
    each is a translucent glass card instead (dark for assurances, white for
    the shopping sections); an opaque one would just paint over the video
    again, exactly like the mobile-band days this replaced.
  --}}
  <div class="relative" data-fixed-video-scope>
    {{!--
      bg-ink-950 here is only a fallback (loading flash, no-JS, reduced
      motion); the video sits at full opacity through every section in this
      wrapper, not just this one.
    --}}
    <section class="relative isolate overflow-hidden bg-ink-950 pb-20 pt-[104px] sm:pb-24 lg:pb-28 lg:pt-[120px]">
      <video
        class="fixed inset-0 -z-10 h-full w-full object-cover object-center"
        data-autoplay-video
        src="{{page.hero.video.src}}"
        poster="{{page.hero.video.poster}}"
        aria-hidden="true"
        autoplay
        muted
        loop
        playsinline
      ></video>
      <div
        class="absolute inset-0 -z-10"
        style="background:linear-gradient(90deg,#04070d 0%,rgba(4,7,13,0.92) 38%,rgba(4,7,13,0.55) 68%,rgba(4,7,13,0.25) 100%)"
      ></div>
      <div
        class="absolute inset-0 -z-10"
        style="background:linear-gradient(180deg,rgba(4,7,13,0.5) 0%,transparent 26%,transparent 70%,rgba(4,7,13,0.6) 100%)"
      ></div>

      <div class="container relative">
        <div class="max-w-2xl">
          <p class="eyebrow-on-dark">{{page.hero.eyebrow}}</p>

          {{!-- Capped at 3.9rem so each of the three lines stays on one line --}}
          <h1 class="mt-5 font-display text-[clamp(2.4rem,5vw,3.9rem)] font-extrabold uppercase leading-[0.96] tracking-tight text-white">
            {{page.hero.titleLead}}
            <span class="block text-accent-400">{{page.hero.titleAccent}}</span>
            {{page.hero.titleTail}}
          </h1>

          <p class="mt-6 max-w-md text-[15px] leading-7 text-ink-200">{{page.hero.copy}}</p>

          <div class="mt-9 flex flex-wrap items-center gap-4">
            <a href="{{page.hero.primaryCta.href}}" class="btn-primary">
              {{page.hero.primaryCta.label}}
              {{{icon "arrow-right" "h-4 w-4"}}}
            </a>
            <a href="{{page.hero.secondaryCta.href}}" class="btn-outline">
              {{page.hero.secondaryCta.label}}
            </a>
          </div>

          <ul class="mt-10 flex flex-wrap gap-x-7 gap-y-3">
            {{#each page.hero.promises}}
              <li class="flex items-center gap-2.5 text-sm font-semibold text-white">
                <span class="grid h-9 w-9 place-items-center rounded-full border border-white/15 bg-white/[0.06] text-accent-400">
                  {{{icon this.icon "h-4 w-4"}}}
                </span>
                {{this.label}}
              </li>
            {{/each}}
          </ul>
        </div>
      </div>
    </section>

    {{!-- ------------------------------------------------------- assurances --}}
    <section id="assurances" class="relative pb-20 lg:pb-24">
      <div class="container">
        <div class="rounded-[2.5rem] border border-white/10 bg-ink-950/55 px-7 py-12 shadow-lift backdrop-blur-xl lg:px-12">
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-accent-500">
            {{page.assurances.eyebrow}}
          </p>
          <h2 class="mt-4 max-w-2xl font-display text-3xl font-extrabold leading-tight tracking-tight text-white sm:text-4xl">
            {{page.assurances.title}}
            <span class="text-accent-500">{{page.assurances.titleAccent}}</span>
          </h2>
          <p class="mt-4 max-w-xl text-sm leading-7 text-ink-300">{{page.assurances.copy}}</p>

          <div class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-4 lg:gap-0 lg:divide-x lg:divide-white/10">
            {{#each page.assurances.items}}
              <div class="reveal lg:px-7 lg:first:pl-0 lg:last:pr-0">
                <span class="grid h-11 w-11 place-items-center rounded-xl border border-accent-500/40 text-accent-500">
                  {{{icon this.icon "h-5 w-5"}}}
                </span>
                <h3 class="mt-5 text-sm font-extrabold uppercase tracking-wide text-white">{{this.title}}</h3>
                <p class="mt-2 text-[13px] leading-6 text-ink-300">{{this.body}}</p>
              </div>
            {{/each}}
          </div>
        </div>
      </div>
    </section>

    {{!-- --------------------------------------------------------- services --}}
    <section id="services" class="relative py-20 lg:py-24">
      <div class="container">
        <div class="rounded-[2.5rem] border border-white/40 bg-white/75 p-7 shadow-lift backdrop-blur-xl sm:p-10 lg:p-12">
          <div class="reveal flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <p class="eyebrow">{{page.services.eyebrow}}</p>
              <h2 class="max-w-md font-display text-3xl font-extrabold leading-tight tracking-tight text-ink-900 sm:text-4xl">
                Explore what
                <span class="text-brand-600">we supply</span>
              </h2>
              <span class="mt-4 block h-1 w-12 rounded-full bg-accent-500"></span>
            </div>
            <p class="max-w-sm text-sm leading-6 text-ink-400">{{page.services.copy}}</p>
          </div>

          <div class="mt-12 grid gap-6 lg:grid-cols-3">
            {{#each page.services.items}}
              <article class="reveal group flex flex-col overflow-hidden rounded-[1.75rem] bg-white shadow-soft transition duration-300 hover:-translate-y-1.5 hover:shadow-lift">
                <div class="relative bg-ink-50 p-5">
                  <img
                    class="h-44 w-full rounded-2xl object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                    src="{{this.image.src}}"
                    alt="{{this.image.alt}}"
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="absolute right-8 top-8 grid h-10 w-10 place-items-center rounded-xl bg-white/90 text-brand-600 shadow-soft backdrop-blur">
                    {{{icon this.icon "h-5 w-5"}}}
                  </span>
                </div>

                <div class="flex flex-1 flex-col p-7 pt-5">
                  <h3 class="text-lg leading-tight">{{this.title}}</h3>
                  <p class="mt-2 text-sm leading-6 text-ink-400">{{this.summary}}</p>

                  <ul class="mt-5 flex-1 space-y-2.5 border-t border-ink-100 pt-5">
                    {{#each this.features}}
                      <li class="flex items-start gap-2.5 text-[13px] leading-5 text-ink-700">
                        <span class="mt-0.5 grid h-4 w-4 shrink-0 place-items-center rounded-full bg-accent-100 text-accent-700">
                          {{{icon "check" "h-2.5 w-2.5"}}}
                        </span>
                        {{this}}
                      </li>
                    {{/each}}
                  </ul>

                  <div class="mt-6 flex items-center justify-between border-t border-ink-100 pt-5">
                    <p class="flex items-center gap-2 text-[11px] font-bold uppercase tracking-wider text-ink-500">
                      {{{icon "clock" "h-3.5 w-3.5 text-brand-600"}}}
                      {{this.outcome}}
                    </p>
                    <a
                      href="#request"
                      data-service="sales-supply"
                      class="grid h-10 w-10 place-items-center rounded-full bg-accent-500 text-ink-900 transition-transform duration-300 hover:scale-110"
                      aria-label="Request a quotation for {{this.title}}"
                    >
                      {{{icon "arrow-right" "h-4 w-4"}}}
                    </a>
                  </div>
                </div>
              </article>
            {{/each}}
          </div>
        </div>
      </div>
    </section>

    {{!-- -------------------------------------------------------- catalogue --}}
    {{> catalogue}}
  </div>

  {{!-- ------------------------------------------------------------ stats --}}
  <section class="relative bg-ink-50/60 pb-20 lg:pb-24">
    <div class="container">
      <dl class="reveal grid gap-8 rounded-[2rem] bg-gradient-to-r from-brand-700 to-brand-500 px-8 py-9 sm:grid-cols-3 sm:gap-0 sm:divide-x sm:divide-white/20">
        {{#each page.metrics.items}}
          <div class="flex items-center justify-center gap-4 sm:px-6">
            <div class="text-center sm:text-left">
              <dd class="font-display text-3xl font-extrabold leading-none text-white">{{this.value}}</dd>
              <dt class="mt-1.5 text-xs font-semibold uppercase tracking-wider text-brand-50/90">{{this.label}}</dt>
            </div>
          </div>
        {{/each}}
      </dl>
    </div>
  </section>

  {{!-- ---------------------------------------------------------- process --}}
  <section class="relative bg-white py-20 lg:py-24">
    <div class="container">
      <div class="reveal mx-auto max-w-2xl text-center">
        <p class="eyebrow justify-center">{{page.process.eyebrow}}</p>
        <h2 class="h2">
          {{page.process.title}}
          <span class="block text-brand-600">{{page.process.titleAccent}}</span>
        </h2>
        <p class="lead mt-5">{{page.process.copy}}</p>
      </div>

      <ol class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {{#each page.process.steps}}
          <li class="reveal rounded-2xl border border-ink-100 bg-white p-6 shadow-soft">
            <span class="grid h-11 w-11 place-items-center rounded-full bg-ink-900 font-display text-sm font-extrabold text-accent-400">
              {{inc @index}}
            </span>
            <h3 class="mt-5 text-base font-bold text-ink-900">{{this.title}}</h3>
            <p class="mt-2 text-[13px] leading-6 text-ink-400">{{this.body}}</p>
          </li>
        {{/each}}
      </ol>
    </div>
  </section>

  {{!-- --------------------------------------------------- closing panel --}}
  <section class="relative bg-white pb-20 lg:pb-24">
    <div class="container">
      <div class="grid overflow-hidden rounded-[2.5rem] bg-ink-950 lg:grid-cols-[0.85fr_1.15fr]">
        <div class="relative min-h-[240px]">
          <img
            src="{{page.closing.image.src}}"
            alt="{{page.closing.image.alt}}"
            class="absolute inset-0 h-full w-full object-cover object-[center_32%]"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute inset-0 bg-gradient-to-r from-transparent to-ink-950 lg:to-ink-950"></div>
        </div>

        <div class="grid items-center gap-8 p-8 sm:p-12 lg:grid-cols-[1.1fr_0.9fr]">
          <div>
            <span class="font-display text-5xl font-extrabold leading-none text-accent-500">&ldquo;</span>
            <p class="mt-2 font-display text-xl font-bold leading-snug text-white sm:text-[22px]">
              {{page.closing.statement}}
            </p>
            <p class="mt-4 text-xs font-semibold uppercase tracking-wider text-ink-400">
              {{page.closing.attribution}}
            </p>
          </div>

          <div class="rounded-2xl border border-accent-500/40 p-6">
            <h3 class="text-base uppercase leading-tight text-white">{{page.closing.cta.title}}</h3>
            <p class="mt-2.5 text-[13px] leading-6 text-ink-300">{{page.closing.cta.body}}</p>
            <a href="{{page.closing.cta.href}}" class="pill-cta mt-6 w-full whitespace-nowrap !pl-5 !text-[13px]">
              {{page.closing.cta.label}}
              <span class="pill-cta-badge">{{{icon "arrow-right" "h-4 w-4"}}}</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  {{!-- ------------------------------------------------------- conversion --}}
  <section class="relative bg-white pb-20">
    <div class="container">
      <div class="reveal mx-auto max-w-2xl text-center">
        <h2 class="h2">
          {{page.ctaBand.title}}
          <span class="block text-brand-600">{{page.ctaBand.titleAccent}}</span>
        </h2>
        <p class="lead mt-5">{{page.ctaBand.copy}}</p>
      </div>
    </div>

    <div class="mt-12">{{> request-bar}}</div>
  </section>
</main>

{{> quote-basket}}
{{> side-rail}}
{{> footer}}
